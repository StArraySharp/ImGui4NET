<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>ImGui4NET.Backend.DirectX9</AssemblyName>
    <RootNamespace>ImGui4NET.Backend.DirectX9</RootNamespace>
    <PackageId>ImGui4NET.Backend.DirectX9</PackageId>
    <Description>Dear ImGui Direct3D 9 renderer backend. Part of ImGui4NET.</Description>
    <PackageTags>imgui;dear-imgui;backend;directx9</PackageTags>
    <IsPackable>true</IsPackable>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS8981;CS0108;CS0114;CS8669;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImGui4NET\ImGui4NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D9" Version="$(SilkNetVersion)" />
  </ItemGroup>

</Project>


