<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>ImGui4NET.Backend.Metal4</AssemblyName>
    <RootNamespace>ImGui4NET.Backend.Metal4</RootNamespace>
    <PackageId>ImGui4NET.Backend.Metal4</PackageId>
    <Description>Dear ImGui Metal 4 renderer backend (macOS 26+, Apple Silicon). Part of ImGui4NET.</Description>
    <PackageTags>imgui;dear-imgui;backend;metal;metal4;macos</PackageTags>
    <IsPackable>true</IsPackable>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS8981;CS0108;CS0114;CS8669;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImGui4NET\ImGui4NET.csproj" />
  </ItemGroup>

</Project>